DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=

# Google Search Console (server only; never prefix these with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/google/callback
# Optional legacy fallback; Connect Google stores an encrypted token in PostgreSQL.
GOOGLE_REFRESH_TOKEN=
GSC_ALLOWED_CLIENT_SLUGS=aurixlab,budget-promotion,cpc-clinics,merch-express

# Remote MCP OAuth: register a static client in Claude using these credentials.
MCP_ORIGIN=https://YOUR-DOMAIN
MCP_CLIENT_ID=aurixlab-gsc
MCP_CLIENT_SECRET=
# Separate random secret of at least 32 characters.
MCP_SIGNING_SECRET=
# Exact comma-separated OAuth callback URLs from your Claude clients; no wildcards.
MCP_REDIRECT_URIS=

# Posting Automation
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v21.0

# Product Automation
GEMINI_API_KEY=
PRODUCT_COPY_GEMINI_MODEL=gemini-2.5-flash-lite
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
# S&S Activewear API (ssactivewear.com/myaccount). When set, S&S links use the API instead of scraping.
SS_ACTIVEWEAR_ACCOUNT_NUMBER=
SS_ACTIVEWEAR_API_KEY=


# Keep disabled while proposed product enrichment content is being reviewed.
PRODUCT_ENRICHMENT_SHOPIFY_WRITES_ENABLED=false
