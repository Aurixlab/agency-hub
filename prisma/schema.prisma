generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  name               String
  email              String?
  altEmail           String?   @map("alt_email")
  avatarUrl          String?   @map("avatar_url")
  bio                String?
  role               Role      @default(MEMBER)
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  disabled           Boolean   @default(false)
  loginAttempts      Int       @default(0) @map("login_attempts")
  lockedUntil        DateTime? @map("locked_until")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  assignedTasks Task[]         @relation("TaskAssignee")
  comments      Comment[]
  activities    ActivityLog[]
  notifications Notification[]
  pipelines     Pipeline[]
  transcriptImports TranscriptImport[]
  productAutomationRuns ProductAutomationRun[]

  @@map("users")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String   @default("layout-template")
  color       String   @default("#3366ff")
  seedConfig  Json     @map("seed_config")
  createdAt   DateTime @default(now()) @map("created_at")

  projects Project[]

  @@map("templates")
}

model Project {
  id         String    @id @default(cuid())
  name       String
  clientName String?   @map("client_name")
  templateId String?   @map("template_id")
  status     String    @default("active")
  statuses   Json      @default("[]")
  priorities Json      @default("[]")
  tags       Json      @default("[]")
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  template Template? @relation(fields: [templateId], references: [id])
  tasks    Task[]

  @@map("projects")
}

model Task {
  id          String    @id @default(cuid())
  projectId   String?   @map("project_id")
  title       String
  description String?
  status      String    @default("Backlog")
  priority    Priority  @default(NONE)
  assigneeId  String?   @map("assignee_id")
  assigneeIds Json      @default("[]") @map("assignee_ids")
  dueDate     DateTime? @map("due_date")
  doneDate    DateTime? @map("done_date")
  tags        Json      @default("[]")
  orderIndex  Int       @default(0) @map("order_index")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments Comment[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@map("comments")
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("activity_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  taskId    String?  @map("task_id")
  actorName String   @map("actor_name")
  taskTitle String   @map("task_title")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@map("sessions")
}

model Pipeline {
  id        String         @id @default(cuid())
  name      String
  createdBy String         @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  nodes     PipelineNode[]
  creator   User           @relation(fields: [createdBy], references: [id])

  @@map("pipelines")
}

model PipelineNode {
  id          String   @id @default(cuid())
  pipelineId  String   @map("pipeline_id")
  label       String
  description String?
  assigneeIds Json     @default("[]") @map("assignee_ids")
  positionX   Float    @map("position_x")
  positionY   Float    @map("position_y")
  edges       Json     @default("[]")
  done        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@map("pipeline_nodes")
}

model TranscriptImport {
  id         String      @id @default(cuid())
  uploadedBy String      @map("uploaded_by")
  fileName   String      @map("file_name")
  createdAt  DateTime    @default(now()) @map("created_at")
  drafts     TaskDraft[]
  uploader   User        @relation(fields: [uploadedBy], references: [id])

  @@map("transcript_imports")
}

model TaskDraft {
  id                   String           @id @default(cuid())
  importId             String           @map("import_id")
  title                String
  description          String?
  priority             Priority         @default(NONE)
  suggestedAssigneeIds Json             @default("[]") @map("suggested_assignee_ids")
  suggestedDueDate     DateTime?        @map("suggested_due_date")
  status               String           @default("pending")
  createdAt            DateTime         @default(now()) @map("created_at")
  import               TranscriptImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, status])
  @@map("task_drafts")
}

model ScrapedReel {
  id              String   @id @default(cuid())
  instagramId     String   @unique @map("instagram_id")
  url             String
  caption         String?
  playCount       BigInt   @default(0) @map("play_count")
  likeCount       BigInt   @default(0) @map("like_count")
  commentCount    BigInt   @default(0) @map("comment_count")
  authorUsername  String   @map("author_username")
  authorFollowers BigInt   @default(1) @map("author_followers")
  locationName    String?  @map("location_name")
  locationId      String?  @map("location_id")
  viralScore      Float    @default(0) @map("viral_score")
  searchTopic     String   @map("search_topic")
  scrapedAt       DateTime @default(now()) @map("scraped_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([searchTopic, viralScore])
  @@map("scraped_reels")
}

model CreativeItem {
  id             String   @id @default(cuid())
  source         String
  sourceItemId   String   @unique @map("source_item_id")
  type           String
  url            String
  thumbnailUrl   String?  @map("thumbnail_url")
  videoUrl       String?  @map("video_url")
  caption        String?
  adCopy         String?  @map("ad_copy")
  creatorName    String?  @map("creator_name")
  creatorHandle  String?  @map("creator_handle")
  platform       String
  country        String?
  city           String?
  topic          String
  eventName      String?  @map("event_name")
  publishedAt    DateTime? @map("published_at")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  viewCount      BigInt   @default(0) @map("view_count")
  likeCount      BigInt   @default(0) @map("like_count")
  commentCount   BigInt   @default(0) @map("comment_count")
  shareCount     BigInt   @default(0) @map("share_count")
  relevanceScore Float    @default(0) @map("relevance_score")
  viralScore     Float    @default(0) @map("viral_score")
  recencyScore   Float    @default(0) @map("recency_score")
  localityScore  Float    @default(0) @map("locality_score")
  businessScore  Float    @default(0) @map("business_score")
  creativeScore  Float    @default(0) @map("creative_score")
  finalScore     Float    @default(0) @map("final_score")
  hook           String?
  visualStyle    String?  @map("visual_style")
  contentAngle   String?  @map("content_angle")
  productFit     String?  @map("product_fit")
  targetAudience String?  @map("target_audience")
  aiSummary      String?  @map("ai_summary")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([topic, finalScore])
  @@index([source, topic])
  @@index([platform, topic])
  @@index([eventName])
  @@map("creative_items")
}

model CreativeSearchJob {
  id              String   @id @default(cuid())
  topic           String
  normalizedTopic String   @map("normalized_topic")
  status          String
  keywords        Json
  hashtags        Json?
  sources         Json
  providerRuns    Json?    @map("provider_runs")
  error           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  completedAt     DateTime? @map("completed_at")

  @@index([normalizedTopic, status])
  @@map("creative_search_jobs")
}

model TrendEvent {
  id        String   @id @default(cuid())
  name      String
  country   String
  city      String?
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  category  String
  keywords  Json
  products  Json
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([country, city])
  @@index([category])
  @@map("trend_events")
}

model ProductAutomationRun {
  id                String   @id @default(cuid())
  createdBy         String   @map("created_by")
  productLink       String   @map("product_link")
  basePrice         Decimal  @map("base_price") @db.Decimal(10, 2)
  decorationType    String   @map("decoration_type")
  colors            Json     @default("[]")
  imagesReady       Boolean  @default(false) @map("images_ready")
  scrapedData       Json?    @map("scraped_data")
  aiCopy            Json?    @map("ai_copy")
  pricing           Json?
  variants          Json?
  shopifyPayload    Json?    @map("shopify_payload")
  status            String   @default("draft")
  shopifyProductId  String?  @map("shopify_product_id")
  shopifyProductUrl String?  @map("shopify_product_url")
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@map("product_automation_runs")
}
