{
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-seo",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 11 1 * *"
    },
    {
      "path": "/api/cron/publish-posts",
      "schedule": "*/5 * * * *"
    }
  ]
}
